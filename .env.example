# ============================================================
# Adobe Experience Platform (AEP) – Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.

# --- Adobe IMS / OAuth 2.0 (Service Account / JWT) ----------
AEP_CLIENT_ID=your_client_id
AEP_CLIENT_SECRET=your_client_secret
AEP_ORG_ID=your_org_id@AdobeOrg
AEP_SANDBOX_NAME=prod          # or your sandbox name
AEP_IMS_TOKEN_URL=https://ims-na1.adobelogin.com/ims/token/v3
AEP_SCOPES=openid,AdobeID,read_organizations,additional_info.projectedProductContext,session

# --- AEP API Base URL ----------------------------------------
AEP_BASE_URL=https://platform.adobe.io

# --- PostgreSQL Source Connection ----------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aep_poc
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_pg_password
POSTGRES_SOURCE_CONNECTION_SPEC_ID=74a1c565-2e08-496b-9d42-c0b84d1a77af  # AEP Postgres spec

# --- Web App -------------------------------------------------
PORT=3000
NODE_ENV=development
